# Chat model: any OpenAI-compatible endpoint. Default is BoxAPI AI.
LLM_API_KEY=box-ai-...
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_MODEL=gpt-5.4-mini
# none | low | medium | high — "none" is fastest
LLM_REASONING_EFFORT=none
# Fallback: GapGPT (used only when LLM_API_KEY is unset)
# GAPGPT_API_KEY=sk-...
# GAPGPT_MODEL=gapgpt-qwen-3.6
PORT=3000

# Admin trace viewer at /admin?token=...
ADMIN_TOKEN=

# Kill switch: set to false to stop the agent (or create data/KILL_SWITCH)
AGENT_ENABLED=true

# BoxAPI (Instagram). Without these, Instagram checks report "not configured".
BOXAPI_TOKEN=
BOXAPI_ACCOUNT_ID=
BOXAPI_WEBHOOK_SECRET=
# BOXAPI_DATA_BASE_URL=https://boxapi.ir/api/instagram
# BOXAPI_DM_BASE_URL=https://boxapi.ir/api/instagram/dm

# Paths (defaults suit local dev; the Docker image overrides them)
# DB_PATH=data/torob.db
# DATA_DIR=data

# Neshan maps (optional; falls back to OpenStreetMap). Web key is sent to browsers by design.
NESHAN_WEB_KEY=web....
NESHAN_SERVICE_KEY=service....
